# 이 파일을 .env 로 복사해 로컬 값만 채우세요. .env 는 .gitignore 에 포함되어 커밋되지 않습니다.
# OpenAI API 키와 ChatGPT 로그인 토큰은 브라우저 localStorage 에만 저장되므로 여기에 넣을 필요가 없습니다.

# serve.py 중계 대상 (기본값 https://api.openai.com)
RPT_UPSTREAM=

# test/ 검증 스크립트용
APP_URL=http://127.0.0.1:8765/index.html
FILE_URL=
RUN_NAME=
SERVE_PY=
APP_DIR=
